<Window x:Class="GLWinTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GL WinTool" Height="760" Width="1180" MinHeight="620" MinWidth="980"
        Background="#EEF3F8" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="86"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="124"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#060A17" CornerRadius="18" Padding="18">
      <DockPanel>
        <Image x:Name="LogoImage" Width="58" Height="58" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,14,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="GL WinTool" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock Text="Central de instalacao, ajustes e manutencao Windows" Foreground="#BFDBFE" FontSize="13"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#93C5FD" VerticalAlignment="Center" TextAlignment="Right"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,14,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="14">
        <StackPanel>
          <TextBlock Text="Acoes" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Button Content="+ Instalar selecionados" Click="InstallSelected_Click"/>
          <Button Content="Atualizar selecionados" Click="UpgradeSelected_Click"/>
          <Button Content="Desinstalar selecionados" Click="UninstallSelected_Click"/>
          <Button Content="Atualizar todos" Click="UpgradeAll_Click"/>
          <Separator Margin="0,12"/>
          <TextBlock Text="Selecao" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <Button Content="Limpar selecao" Click="ClearSelection_Click"/>
          <TextBlock x:Name="SelectionText" Margin="4,12,0,0" Foreground="#334155"/>
        </StackPanel>
      </Border>

      <DockPanel Grid.Column="1" Margin="14,0,0,0">
        <StackPanel DockPanel.Dock="Top">
          <TextBox x:Name="SearchBox" Height="34" Margin="0,0,0,8" TextChanged="SearchBox_TextChanged"/>
          <TabControl x:Name="MainTabs" Height="42">
            <TabItem Header="Instalar"/>
            <TabItem Header="Ajustes"/>
            <TabItem Header="Configurar"/>
            <TabItem Header="Atualizar"/>
            <TabItem Header="AppX"/>
            <TabItem Header="Win11"/>
          </TabControl>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="AppsList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="280" Height="82" Margin="6" Padding="10" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="54"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="#E0F2FE">
                      <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0F172A"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A"/>
                      <TextBlock Text="{Binding Description}" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Id}" Foreground="#475569" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" IsChecked="{Binding Selected}" VerticalAlignment="Center" Click="AppCheck_Click"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <Border Grid.Row="2" Background="#0F172A" CornerRadius="12" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="LogText" FontFamily="Consolas" Foreground="White" TextWrapping="Wrap"/>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
